# Humble Upgrade environment variables.
# Copy to .env and fill in values. Never commit a real .env.

# Required: bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Optional: your server ID (instant slash-command sync)
DISCORD_GUILD_ID=

# Operator Discord user ID (unlocks /judge commands)
OWNER_USER_ID=

# Paths (Docker/Railway image defaults to the /data volume)
DATABASE_PATH=
BACKUP_DIR=
BACKUP_KEEP=5
BACKUP_TIMEZONE=America/Chicago
BACKUP_AT=4:00

# Channel IDs (all optional)
LOG_CHANNEL_ID=
WELCOME_ENABLED=false
WELCOME_CHANNEL_ID=
PINBOARD_CHANNEL_ID=
PINBOARD_REACTION_THRESHOLD=5
MEDIA_CHANNEL_ID=
MEME_CHANNEL_ID=
EVENT_ANNOUNCE_CHANNEL_ID=
QUOTE_OF_DAY_CHANNEL_ID=
BOT_UPDATES_CHANNEL_ID=

# Who can use /log (comma-separated IDs). Empty = nobody extra.
LOG_ALLOWED_USER_IDS=
LOG_ALLOWED_ROLE_IDS=

# Translation (optional; otherwise /translate uses a keyless fallback)
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
MYMEMORY_EMAIL=
TRANSLATE_TIMEOUT_SECONDS=8
AUTO_TRANSLATE_ENABLED=true
AUTO_TRANSLATE_TARGET=en
AUTO_TRANSLATE_MIN_CHARS=18
AUTO_TRANSLATE_MIN_CONFIDENCE=0.55
AUTO_TRANSLATE_COOLDOWN_SECONDS=8
AUTO_TRANSLATE_SKIP_CHANNELS=

# Chat backend. On a local machine, leave CHAT_BACKEND unset to use Ollama.
# On Railway, set CHAT_BACKEND=openrouter and provide a key.
CHAT_BACKEND=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BOT_CHAT_MODEL=
OLLAMA_URL=

# Railway cutover helpers
WAIT_FOR_DB=0
BOOTSTRAP_DB_URL=

# Optional comma-separated disable list, e.g. cogs.translate
DISABLED_COGS=

# Optional nickname seeds for the chat persona (id:Nick,id:Nick)
CHAT_SEED_NICKS=
CHAT_WOMEN_IDS=

# Maintenance
MAINTENANCE_MESSAGE=
MAINTENANCE_ALLOW_USER_IDS=

# Economy / games (optional overrides; defaults live in config.py)
MESSAGE_REWARD=10
GAME_DAY_TIMEZONE=UTC
